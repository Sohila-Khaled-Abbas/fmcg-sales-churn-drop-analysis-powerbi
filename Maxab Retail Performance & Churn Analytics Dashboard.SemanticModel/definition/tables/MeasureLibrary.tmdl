	/// Average working-day delivery per DayOfWeek×WeekOfMonth cell. Drop into Matrix rows=DayOfWeek, cols=WeekOfMonth for the heatmap.
	measure 'Heatmap Avg Delivery' =
			
			CALCULATE(
			    AVERAGEX(
			        FILTER(Fact_Order, NOT ISBLANK(Fact_Order[Delivered])),
			        CALCULATE(
			            COUNTROWS(Dim_Date),
			            DATESBETWEEN(Dim_Date[Date], Fact_Order[Created], Fact_Order[Delivered]),
