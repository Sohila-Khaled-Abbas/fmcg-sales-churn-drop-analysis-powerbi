	/// Shows the last date in the data across orders and order lines
	/// 
	measure 'Last Refresh Date' = ```
			
			VAR MaxOrdersDate =
			    MAXX(
			        Fact_Order,
			        MAX(Fact_Order[Created], Fact_Order[Delivered])
			    )
			VAR MaxOrderLinesDate =
			    MAX(Fact_OrderLines[OrderCreation])
			RETURN
			    MAX(MaxOrdersDate, MaxOrderLinesDate)
			
			```
		formatString: General Date
		displayFolder: Last Refresh / Data Freshness
		lineageTag: 56d8ecac-5e91-465d-9aea-212f5e41ba3f

	/// Human-readable card text
	/// 
	/// 
	measure 'Last Refresh Info' =
			
			"Data last refreshed on " & FORMAT([Last Refresh Date], "MMMM dd, yyyy")
		displayFolder: Last Refresh / Data Freshness
		lineageTag: 26c4a013-ec47-4924-85e9-781807cdac9f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Average working-day delivery duration per order. SLA target is driven dynamically by the DeliveryThresholdDays slicer (default = 2).
	measure 'Delivery SLA (Working Days)' = ```
			
			AVERAGEX(
			    FILTER(Fact_Order, NOT ISBLANK(Fact_Order[Delivered])),
			    CALCULATE(
			        COUNTROWS(Dim_Date),
			        DATESBETWEEN(Dim_Date[Date], Fact_Order[Created], Fact_Order[Delivered]),
			        Dim_Date[IsWorkingDay] = 1
			    )
			)
			
			```
		formatString: 0
		displayFolder: Performance KPIs
		lineageTag: e1df9435-9fff-44c7-af51-38ec7aa17fac

	/// % of delivered orders meeting the dynamic SLA threshold (set via DeliveryThresholdDays slicer, default = 2 working days)
	measure 'SLA Status' = ```
			
			VAR Threshold = [Delivery Threshold Days Value]
			VAR DeliveredOrders =
			    FILTER(Fact_Order, NOT ISBLANK(Fact_Order[Delivered]))
			VAR OnTimeOrders =
			    FILTER(
			        DeliveredOrders,
			        CALCULATE(
			            COUNTROWS(Dim_Date),
			            DATESBETWEEN(Dim_Date[Date], Fact_Order[Created], Fact_Order[Delivered]),
			            Dim_Date[IsWorkingDay] = 1
			        ) <= Threshold
			    )
			RETURN
			DIVIDE(COUNTROWS(OnTimeOrders), COUNTROWS(DeliveredOrders), 0)
			
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Performance KPIs
		lineageTag: 8df76f87-bf9e-47ee-9385-7e96882b86fd

		annotation PBI_FormatHint = {"isText":true}

	/// Returns the selected delivery SLA threshold from the slicer, defaulting to 2 working days if no selection is made.
	measure 'Delivery Threshold Days Value' = SELECTEDVALUE('DeliveryThresholdDays'[Delivery Threshold Days], 2)
		formatString: 0" days"
