	measure 'Total NMV' = SUM(Fact_MaxabNMV[Total Sales])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: Commercial / Juice
		lineageTag: 2fa101d7-a0cb-43bf-9844-7f43f5a65067

