		lineageTag: f3a060e7-7976-443a-a39a-64deeb9a373a

	/// Count of orders delivered within the dynamic SLA threshold
	measure 'On Time Orders' =
			
			VAR Threshold = [Delivery Threshold Days Value]
			VAR DeliveredOrders =
			    FILTER(Fact_Order, NOT ISBLANK(Fact_Order[Delivered]))
			RETURN
			COUNTROWS(
			    FILTER(
			        DeliveredOrders,
			        CALCULATE(
			            COUNTROWS(Dim_Date),
			            DATESBETWEEN(Dim_Date[Date], Fact_Order[Created], Fact_Order[Delivered]),
			            Dim_Date[IsWorkingDay] = 1
			        ) <= Threshold
			    )
			)
		formatString: #,0
		displayFolder: P2 — Performance & Delivery
		lineageTag: 322715f5-0115-4d66-b110-9abab878383c

	/// Count of orders exceeding the dynamic SLA threshold (working days)
	measure 'Late Orders' =
			
			VAR Threshold = [Delivery Threshold Days Value]
			VAR DeliveredOrders =
			    FILTER(Fact_Order, NOT ISBLANK(Fact_Order[Delivered]))
			RETURN
			COUNTROWS(
			    FILTER(
			        DeliveredOrders,
			        CALCULATE(
			            COUNTROWS(Dim_Date),
			            DATESBETWEEN(Dim_Date[Date], Fact_Order[Created], Fact_Order[Delivered]),
			            Dim_Date[IsWorkingDay] = 1
			        ) > Threshold
			    )
			)
		formatString: #,0
		displayFolder: P2 — Performance & Delivery
		lineageTag: 4a98da4c-3b67-43e1-a743-f82edd77129a

