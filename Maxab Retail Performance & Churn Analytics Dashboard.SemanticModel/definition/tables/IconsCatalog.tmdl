table IconsCatalog
	lineageTag: f0a2ebe5-7715-4d3a-9649-2e2e66932562

	measure Icon = ```
			
			VAR IconType="Home" // ✅ Uses IconType
			
			VAR Color = "242423" // ✅ Uses HTML Color
			RETURN
			IconSelector(IconType, Color)
			
			```
		lineageTag: 59399702-3f21-4bbd-8898-5be9375bebf2

