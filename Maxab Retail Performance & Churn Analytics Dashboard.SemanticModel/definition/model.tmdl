model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Functions

	annotation PBI_QueryGroupOrder = 0

queryGroup 'Fact Tables'

	annotation PBI_QueryGroupOrder = 1

queryGroup 'Dim Tables'

	annotation PBI_QueryGroupOrder = 2

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Fact_Order","Fact_OrderLines","Fact_JuiceNMV","Fact_MaxabNMV","Dim_Date","Dim_Retailer","Dim_Region","Dim_Channel","Dim_Product","Dim_Brand","fn_GetRegionGeo","fn_GetPublicHolidays","Holidays_2024"]

annotation PBI_ProTooling = ["CalcGroup","DaxQueryView_Desktop","TMDLView_Desktop","DevMode"]

ref table Fact_Order
ref table Fact_OrderLines
ref table Fact_JuiceNMV
ref table Fact_MaxabNMV
ref table Dim_Date
ref table Dim_Retailer
ref table Dim_Region
ref table Dim_Channel
ref table Dim_Product
ref table Dim_Brand
ref table MeasureLibrary
ref table 'Time Intelligence'
ref table 'Model Measures'
ref table 'Model Tables'
ref table 'Model Columns'
ref table 'Model Relationships'
ref table Holidays_2024
ref table DeliveryThresholdDays
ref table IconsCatalog
ref table 'Data Dictionary'

ref cultureInfo en-US

