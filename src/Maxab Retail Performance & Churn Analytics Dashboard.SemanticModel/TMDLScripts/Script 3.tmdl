		function 'PQL.Assert.ShouldBeGreaterThan' =
				(testName : STRING, threshold : DOUBLE, actual : DOUBLE) =>
				    VAR _Passed = actual > threshold
				    RETURN ROW(
				        "TestName", testName,
				        "Expected", "> " & FORMAT(threshold, ""),
				        "Actual", FORMAT(actual, ""),
				        "Passed", _Passed
				    )
