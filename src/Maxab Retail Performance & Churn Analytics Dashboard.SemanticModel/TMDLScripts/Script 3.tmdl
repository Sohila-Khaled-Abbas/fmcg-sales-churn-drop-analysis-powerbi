			linguisticMetadata = {"Version":"1.0.0","Language":"en-US"}
				contentType: json

		expression fn_GetRegionGeo =
				(Region as text) as record =>
				let
				    Source =
				        Json.Document(
				            Web.Contents(
				                "https://nominatim.openstreetmap.org/search",
				                [
				                    Query = [
				                        q = Region & ", Egypt",
				                        format = "json",
				                        limit = "1"
				                    ],
				                    Headers = [
				                        #"User-Agent" = "PowerBI-Geocoding-Project"
				                    ]
				                ]
				            )
				        ),
				    First = if List.Count(Source) > 0 then Source{0} else null,
				    Lat = if First <> null then First[lat] else null,
				    Lon = if First <> null then First[lon] else null
				in
				    [Latitude = Lat, Longitude = Lon]
			lineageTag: 900efb04-e633-43fd-8884-89d8460804f2
			queryGroup: Functions

			annotation PBI_NavigationStepName = Navigation

			annotation PBI_ResultType = Function

		expression fn_GetPublicHolidays =
				(year as text) =>
				let
				    Source = Json.Document(
				        Web.Contents(
				            "https://date.nager.at/api/v3/PublicHolidays/" & year & "/EG")
				    ),
				    ToTable = Table.FromList(Source, Splitter.SplitByNothing()),
				    Expanded = Table.ExpandRecordColumn(ToTable, "Column1", {"date","localName","name"}, {"Date","LocalName","Name"})
				in
				    Expanded
			lineageTag: fdf4987d-55be-4ee4-877a-08b41ff158fc
			queryGroup: Functions

			annotation PBI_NavigationStepName = Navigation

			annotation PBI_ResultType = Function

		queryGroup Functions

			annotation PBI_QueryGroupOrder = 0

		queryGroup 'Fact Tables'

			annotation PBI_QueryGroupOrder = 1

		queryGroup 'Dim Tables'

			annotation PBI_QueryGroupOrder = 2

		/// Area: convert acres(ac) to square meters(m²)
		function 'DaxLib.Convert.AcresToSquareMeters' =
				(
				    // The area in acres
				    area: DOUBLE
				) =>
				    area * 4046.8564224
			lineageTag: 9a12bdd6-c4a9-4e36-b354-9decd4b9305d

			annotation DAXLIB_PackageId = DaxLib.Convert

			annotation DAXLIB_PackageVersion = 0.1.2

		/// Temperature: convert Celsius(°C) to Fahrenheit(°F)
		function 'DaxLib.Convert.CelsiusToFahrenheit' =
				(
				    // The temperature in Celsius
				    temperature: DOUBLE
				) =>
				    ( temperature * ( 9 / 5 ) ) + 32
			lineageTag: 07ab206a-2660-4883-82ab-d88153dd0a45

			annotation DAXLIB_PackageId = DaxLib.Convert

			annotation DAXLIB_PackageVersion = 0.1.2

		/// Temperature: convert Celsius(°C) to Kelvin(K)
		function 'DaxLib.Convert.CelsiusToKelvin' =
				(
				    // The temperature in Celsius
				    temperature: DOUBLE
				) =>
				    temperature + 273.15
			lineageTag: 14587992-b688-4720-9c49-3d24e0edbb00

			annotation DAXLIB_PackageId = DaxLib.Convert

			annotation DAXLIB_PackageVersion = 0.1.2

		/// Volume: convert cubic feet(ft³) to cubic meters(m³)
		function 'DaxLib.Convert.CubicFeetToCubicMeters' =
				(
				    // The volume in cubic feet
				    volume: DOUBLE
				) =>
				    volume / 35.31466672148859
			lineageTag: a7d8bb67-d4b8-4546-a5ae-9e9866940770

			annotation DAXLIB_PackageId = DaxLib.Convert

			annotation DAXLIB_PackageVersion = 0.1.2

		/// Flow: convert cubic meters per hour (m³/h) to liters per second (L/s)
		function 'DaxLib.Convert.CubicMetersPerHourToLitersPerSecond' =
				(
				    // The flow rate in cubic meters per hour
				    flow: DOUBLE
				) =>
				    flow / 3.6
			lineageTag: 2c6c2b03-c6ab-4380-be8e-3991cdce0ce4

