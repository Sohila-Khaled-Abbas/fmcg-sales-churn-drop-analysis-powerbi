			column 'Holidays / Work Days'
				dataType: string
				lineageTag: d8019bf5-d2f7-414d-ba42-82efe38bb568
				summarizeBy: none
				sourceColumn: Holidays / Work Days

				annotation SummarizationSetBy = Automatic

			partition Dim_Date = m
				mode: import
				queryGroup: 'Dim Tables'
				source =
						let
						    // Get min/max from your real data
						    OrdersMin = Date.From(List.Min(Fact_Orders[Created])),
						    OrdersMax = Date.From(List.Max(Fact_Orders[Created])),
						    JuiceMin = Date.From(List.Min(Fact_JuiceNMV[MonthDate])),
						    JuiceMax = Date.From(List.Max(Fact_JuiceNMV[MonthDate])),
						
						    StartDate = List.Min({OrdersMin, JuiceMin}),
						    EndDate = List.Max({OrdersMax, JuiceMax}),
						
						    Dates = List.Dates(StartDate, Duration.Days(EndDate - StartDate) + 1, #duration(1,0,0,0)),
						    Tbl = Table.FromList(Dates, Splitter.SplitByNothing(), {"Date"}),
						
						    AddYear = Table.AddColumn(Tbl, "Year", each Date.Year([Date]), Int64.Type),
						    AddMonth = Table.AddColumn(AddYear, "Month", each Date.Month([Date]), Int64.Type),
						    AddMonthName = Table.AddColumn(AddMonth, "MonthName", each Date.ToText([Date],"MMMM"), type text),
						    AddYearMonth = Table.AddColumn(AddMonthName, "YearMonth", each Date.ToText([Date],"yyyy-MM"), type text),
						    AddDay = Table.AddColumn(AddYearMonth, "Day", each Date.Day([Date]), Int64.Type),
						
						    // Business WeekOfMonth rule
						    AddWeekOfMonth = Table.AddColumn(AddDay, "WeekOfMonth", each
						        if [Day] <= 7 then 1
						        else if [Day] <= 14 then 2
						        else if [Day] <= 21 then 3
						        else if [Day] <= 28 then 4
						        else 5, Int64.Type),
						
						    AddQuarter = Table.AddColumn(AddWeekOfMonth, "Quarter", each Date.QuarterOfYear([Date]), Int64.Type),
						    #"Changed Type" = Table.TransformColumnTypes(AddQuarter,{{"Date", type date}}),
						    #"Merged Queries" = Table.NestedJoin(#"Changed Type", {"Date"}, Holidays_2024, {"Date"}, "Holidays2024", JoinKind.LeftOuter),
						    #"Expanded Holidays2024" = Table.ExpandTableColumn(#"Merged Queries", "Holidays2024", {"Name"}, {"Name"}),
						    #"Renamed Columns" = Table.RenameColumns(#"Expanded Holidays2024",{{"Name", "Holidays / Work Days"}}),
						    #"Replaced Value" = Table.ReplaceValue(#"Renamed Columns",null,"Work Day",Replacer.ReplaceValue,{"Holidays / Work Days"})
						in
						    #"Replaced Value"

			annotation PBI_NavigationStepName = Navigation

			annotation PBI_ResultType = Table

